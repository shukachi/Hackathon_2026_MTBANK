# Скопируй этот файл в .env и при необходимости поменяй значения.

# Путь к SQLite базе данных (SQLAlchemy URL). Легко заменить на Postgres без переписывания моделей.
DB_URL=sqlite:///./app.db

# Секрет для подписи JWT. ⚠ ЗАМЕНИ В ПРОДЕ — значение ниже сгенерировано только для локальной демки.
JWT_SECRET=b27acb081d6a1ba682110c0bb348d61fe8fd8e0993f81a7a2464537061ef0a99

# Срок жизни JWT access-токена в минутах.
JWT_EXPIRE_MIN=60

# Ollama (локальный AI-слой). Если сервис недоступен — backend работает в rule-based fallback режиме.
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen2.5:1.5b

# Разрешённый origin для CORS (фронтенд дев-сервер).
FRONTEND_ORIGIN=http://localhost:5173
